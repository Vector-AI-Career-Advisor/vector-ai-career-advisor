# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobs_db
DB_USER=postgres
DB_PASSWORD=postgres

# ── MCP server (agent read-only DB access) ──────────────────
# Password for the read-only `vector_agent` Postgres role — see
# scripts/sql/create_agent_role.sql. Only the mcp-db container gets this.
AGENT_DB_PASSWORD=<set-a-strong-password>
# Shared secret used to sign/verify the short-lived per-request identity token
# the app server attaches when calling the MCP server. Only server + mcp-db need it.
AGENT_TOKEN_SECRET=<set-a-strong-random-secret>
# Address the app server reaches the MCP server at when running outside Docker
# (docker-compose sets DOCKER_MCP_URL to the in-network address automatically).
MCP_URL=http://localhost:8100/mcp

# ── Anthropic (agents / chat) ──────────────────────────────
ANTHROPIC_API_KEY=<your-key-here>
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
EVALUATION_MODEL=claude-haiku-4-5-20251001
ORCHESTRATOR_MODEL=claude-haiku-4-5-20251001

# ── ChromaDB ───────────────────────────────────────────────
CHROMA_DIR=./db/chroma_db
CHROMA_COLLECTION=linkedin_jobs_test

CHROME_VERSION=148
DAILY_TARGET=100